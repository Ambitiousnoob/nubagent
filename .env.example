# Required: Gemini API
GEMINI_API_KEY=your_gemini_api_key_here,your_second_gemini_api_key_here
GEMINI_CHAT_MODEL=primary_model,fallback_model,another_fallback_model

# Required: Facebook Messenger Webhook
PAGE_ACCESS_TOKEN=your_facebook_page_access_token
VERIFY_TOKEN=your_webhook_verification_token
POSTGRES_URL=postgresql://user:password@host:5432/database

# Optional: Recommended for current Send API shape
PAGE_ID=your_facebook_page_id

# Optional: Security
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Optional: Runtime controls
GRAPH_API_VERSION=v23.0
GEMINI_CHAT_THINKING_LEVEL=low
SYSTEM_PROMPT=You are NubAgent, a concise and helpful assistant replying inside Facebook Messenger.
