{
  "name": "nubagent",
  "version": "1.0.0",
  "description": "Docs-only frontend with a simple Gemini chat API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "./node_modules/.bin/eslint api lib src",
    "format": "prettier --write \"index.html\" \"api/**/*.js\" \"lib/**/*.js\" \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"index.html\" \"api/**/*.js\" \"lib/**/*.js\" \"src/**/*.{js,jsx}\""
  },
  "keywords": [
    "gemini",
    "chat",
    "docs",
    "react",
    "vercel"
  ],
  "author": "NubAgent Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^3.1.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "vite": "^4.5.14"
  }
}
