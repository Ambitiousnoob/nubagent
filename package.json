{
  "name": "nubagent",
  "version": "1.0.0",
  "description": "AI-powered research assistant and chat interface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint:regex": "node scripts/regex-lint.js",
    "lint": "./node_modules/.bin/eslint api lib scripts src tests",
    "format": "prettier --write \"index.html\" \"api/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.js\" \"src/**/*.{js,jsx}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"index.html\" \"api/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.js\" \"src/**/*.{js,jsx}\" \"tests/**/*.js\""
  },
  "keywords": [
    "ai",
    "chatbot",
    "research",
    "assistant",
    "react",
    "nlp"
  ],
  "author": "NubAgent Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@sentry/react": "^10.46.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.7.0",
    "mysql2": "^3.20.0",
    "posthog-js": "^1.364.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sonner": "^2.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^3.1.0",
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^23.2.0",
    "prettier": "^3.8.1",
    "vite": "^4.5.14",
    "vitest": "^1.6.1"
  }
}
