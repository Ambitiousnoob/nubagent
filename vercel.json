{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/api/web",
      "destination": "/api/web.js"
    },
    {
      "source": "/api/memory",
      "destination": "/api/memory.js"
    },
    {
      "source": "/api/state",
      "destination": "/api/state.js"
    },
    {
      "source": "/api/content",
      "destination": "/api/content.js"
    },
    {
      "source": "/api/research",
      "destination": "/api/research.js"
    },
    {
      "source": "/api/utils",
      "destination": "/api/utils.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/utils.js"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/utils.js"
    },
    {
      "source": "/api/export",
      "destination": "/api/utils.js"
    },
    {
      "source": "/api/messenger",
      "destination": "/api/utils.js"
    },
    {
      "source": "/api/fetch",
      "destination": "/api/content.js"
    },
    {
      "source": "/api/read",
      "destination": "/api/content.js"
    },
    {
      "source": "/api/crawl",
      "destination": "/api/content.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
